package main

import "github.com/rivo/tview"

func main() {
	app := tview.NewApplication()
	table := tview.NewTable().SetBorders(true)

	for row := 0; row < 5; row++ {
		for col := 0; col < 24; col++ {
			table.SetCell(row, col,
				tview.NewTableCell("   "))
		}
	}

	table.SetSelectable(true, true)

	app.SetRoot(table, true).Run()
}
