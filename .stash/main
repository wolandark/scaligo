package main

import "github.com/gdamore/tcell/v2"

func main() {
	s, _ := tcell.NewScreen()
	s.Init()
	defer s.Fini()

	style := tcell.StyleDefault.Foreground(tcell.ColorGreen)

	lineCount := 11
	lineSpacing := 8

	x, y, w, h := 15, 3, 90, 15
	lx, ly, lw, lh := 16, 5, 88, 6
	fx, fy, fh := 15, 3, 15

	// fretboard := [][]string{
	// 	{"E", "F", "F#", "G", "G#", "A", "A#", "B", "C", "C#", "D", "D#", "E"},
	// 	{"B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"},
	// 	{"G", "G#", "A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G"},
	// 	{"D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B", "C", "C#", "D"},
	// 	{"A", "A#", "B", "C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A"},
	// 	{"E", "F", "F#", "G", "G#", "A", "A#", "B", "C", "C#", "D", "D#", "E"},
	// }

	for j := 0; j < h; j++ {
		for i := 0; i < w; i++ {
			c := ' '
			switch {
			case j == 0 && i == 0:
				c = '┌'
			case j == 0 && i == w-1:
				c = '┐'
			case j == h-1 && i == 0:
				c = '└'
			case j == h-1 && i == w-1:
				c = '┘'
			case j == 0 || j == h-1:
				c = '─'
			case i == 0 || i == w-1:
				c = '│'
			}
			s.SetContent(x+i, y+j, c, nil, style)
		}
	}

	for k := 0; k < lineCount; k++ {
		for f := 0; f < fh; f++ {
			s.SetContent(fx+k*lineSpacing, fy+f, '│', nil, style)
		}
	}

	for j1 := 0; j1 < lh; j1++ {
		for i1 := 0; i1 < lw; i1++ {
			r := '-'
			s.SetContent(lx+i1, ly+j1*2, r, nil, style)
		}
	}

	// scale := []string{"C", "D", "E", "F", "G", "A", "B"}

	// for y, row := range fretboard {
	// 	for x, note := range row {
	// 		style := normal

	// 		for _, n := range scale {
	// 			if note == n {
	// 				style = active
	// 				break
	// 			}
	// 		}

	// 		for i, r := range note {
	// 			s.SetContent(5+x*6+i, 3+y*2, r, nil, style)
	// 		}
	// 	}
	// }

	s.Show()
	s.PollEvent()
	s.PollEvent()
}
