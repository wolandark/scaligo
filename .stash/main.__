package main

import "github.com/gdamore/tcell/v2"

func main() {
	s, _ := tcell.NewScreen()
	s.Init()

	defer s.Fini()

	style := tcell.StyleDefault.Foreground(tcell.ColorGreen)

	x, y, w, h := 15, 3, 90, 15
	lx, ly, lw, lh := 16, 5, 88, 6
	fx, fy, fh := 15, 3, 15

	lineCount := 11
	lineSpacing := 8

	for j := 0; j < h; j++ {
		for i := 0; i < w; i++ {
			c := ' '
			switch {
			case j == 0 && i == 0:
				c = '┌'
			case j == 0 && i == w-1:
				c = '┐'
			case j == h-1 && i == 0:
				c = '└'
			case j == h-1 && i == w-1:
				c = '┘'
			case j == 0 || j == h-1:
				c = '─'
			case i == 0 || i == w-1:
				c = '│'
			}
			s.SetContent(x+i, y+j, c, nil, style)
		}
	}

	for j1 := 0; j1 < lh; j1++ {
		for i1 := 0; i1 < lw; i1++ {
			r := '-'
			s.SetContent(lx+i1, ly+j1*2, r, nil, style)
		}
	}

	for k := 0; k < lineCount; k++ {
		for f := 0; f < fh; f++ {
			s.SetContent(fx+k*lineSpacing, fy+f, '│', nil, style)
		}
	}

	s.Show()
	s.PollEvent()
	s.PollEvent()
}
