{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug current Go file",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${file}",
            "args": ["-s", "amin"],
            "console": "integratedTerminal",
            "cwd": "${fileDirname}"
        }
    ]
}